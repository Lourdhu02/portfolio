{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.4",
  "scripts": {
    "dev": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-assets.mjs && velite && next dev",
    "build": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-assets.mjs && velite && next build && node scripts/fix-export-paths.mjs",
    "start": "node scripts/serve-export.mjs",
    "verify": "node scripts/verify.mjs",
    "lint": "eslint",
    "check:claims": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/check-claims.mjs"
  },
  "dependencies": {
    "motion": "^14.6.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "velite": "^0.4.0"
  }
}
